@using MapDemo.Models.Pages
@model MapPage

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <title>PinPoint Maps Editor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@picocss/pico@1/css/pico.min.css">
</head>
<body>
    <main class="container">
        <h1>@Model.Name</h1>
        <p>Latitude: @Model.Map?.Latitude</p>
        <p>Longitude: @Model.Map?.Longitude</p>
    </main>
</body>
</html>